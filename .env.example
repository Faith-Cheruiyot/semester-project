# Copy to .env.local for development. Set these values on your deployment host too.
# Use the public anon/publishable key; application requests use the user's JWT.
NEXT_PUBLIC_SUPABASE_URL=https://jhjpnyjpeinienxtqdex.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Use your deployed site URL in production.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=local

# Caption generation and uploads require a separately configured API.
NEXT_PUBLIC_API_BASE_URL=

# Optional email delivery configuration.
RESEND_API_KEY=
BUG_REPORT_FROM=
BUG_REPORT_RECEIVER=
